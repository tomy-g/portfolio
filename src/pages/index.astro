---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Entry from '../components/Entry.astro'
import HeroField from '../components/HeroField.astro'
import PixelLabel from '../components/PixelLabel.astro'
import Icon from '../components/Icon.astro'
import {
  site,
  experience,
  education,
  projects,
  formatDate,
} from '../data/site'

const year = new Date().getFullYear()

const social = [
  { label: 'GitHub', url: 'https://github.com/tomy-g', icon: 'github' },
  {
    label: 'LinkedIn',
    url: 'https://www.linkedin.com/in/tomas-goizueta/',
    icon: 'linkedin',
  },
  { label: 'Email', url: `mailto:${site.email}`, icon: 'mail' },
  { label: 'CV', url: site.cv, icon: 'file' },
] as const
---

<Layout>
  <a href="#work" class="skip">Skip to content</a>

  <header class="intro">
    <HeroField />
    <div class="shell intro-inner">
      <h1>{site.name}</h1>
      <p class="lede">
        Software engineer at <a
          href="https://ebury.com/"
          target="_blank"
          rel="noopener noreferrer">Ebury</a
        >, in <a
          href={site.locationUrl}
          target="_blank"
          rel="noopener noreferrer">Málaga</a
        >.
      </p>
      <p class="lede">
        I came to code through design, and I still build that way — sketching
        the thing before writing the component, and caring about how it behaves
        once it is on a real screen and a real connection.
      </p>

      <nav class="links" aria-label="Elsewhere">
        {
          social.map((s) => (
            <a
              href={s.url}
              target={s.url.startsWith('mailto') ? undefined : '_blank'}
              rel="noopener noreferrer"
            >
              <Icon name={s.icon} />
              {s.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <div class="shell">
    <main>
      <section id="work" aria-labelledby="work-h">
        <h2 id="work-h"><PixelLabel text="Work" /></h2>
        {
          experience.map((role) => {
            const hasDetail = role.summary !== '' || role.details.length > 0
            return (
              <Entry
                year={role.start.slice(0, 4)}
                heading={role.title}
                subtitle={role.company}
                subtitleUrl={role.companyUrl}
                meta={`${formatDate(role.start)} – ${formatDate(role.end)}`}
                current={role.end === null}
                foldable={hasDetail}
              >
                <Image
                  slot="chip"
                  class="logo"
                  src={role.logo}
                  alt={`${role.company} logo`}
                  width={64}
                  height={64}
                  loading="eager"
                />
                {role.summary && <p>{role.summary}</p>}
                {role.details.map((d) => (
                  <p>{d}</p>
                ))}
                {role.stack.length > 0 && (
                  <ul class="stack">
                    {role.stack.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                )}
              </Entry>
            )
          })
        }
      </section>

      <section id="projects" aria-labelledby="projects-h">
        <h2 id="projects-h"><PixelLabel text="Projects" /></h2>
        {
          projects.map((p) => (
            <Entry
              year={p.year}
              heading={p.name}
              subtitle={p.tagline}
              foldable={true}
            >
              <Image
                slot="chip"
                class="cover"
                src={p.cover}
                alt=""
                width={192}
                height={120}
              />
              {p.body.map((para) => (
                <p>{para}</p>
              ))}
              {p.features && (
                <ul class="features">
                  {p.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              )}
              {p.shots && (
                <div class="shots">
                  {p.shots.map((s) => (
                    <figure>
                      <Image src={s.src} alt={s.alt} width={900} loading="lazy" />
                    </figure>
                  ))}
                </div>
              )}
              <ul class="stack">
                {p.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              <p class="project-links">
                {p.links.map((l) => (
                  <a href={l.url} target="_blank" rel="noopener noreferrer">
                    <Icon name={l.label === 'Source' ? 'github' : 'link'} size={16} />
                    {l.label}
                  </a>
                ))}
              </p>
            </Entry>
          ))
        }
      </section>

      <section id="education" aria-labelledby="education-h">
        <h2 id="education-h"><PixelLabel text="Education" /></h2>
        {
          education.map((e) => (
            <Entry
              year={e.start}
              heading={e.title}
              subtitle={e.institution}
              subtitleUrl={e.institutionUrl}
              meta={`${e.start} – ${e.end}`}
            />
          ))
        }
      </section>

      <section id="contact" aria-labelledby="contact-h">
        <h2 id="contact-h"><PixelLabel text="Contact" /></h2>
        <p class="lede">
          The fastest way to reach me is email. I read everything.
        </p>
        <p class="mail">
          <a href={`mailto:${site.email}`}>
            <Icon name="mail" size={20} />
            {site.email}
          </a>
        </p>
      </section>
    </main>

    <footer>
      <p>© {year} {site.name}</p>
      <p>Built with Astro. No trackers, no cookies.</p>
    </footer>
  </div>
</Layout>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1.5rem;
    top: 1rem;
    z-index: 3;
    background: var(--t-surface);
    padding: 0.5rem 0.75rem;
    color: var(--t-brand);
  }

  .shell {
    max-width: 40rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .intro {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--t-border-subtle);
  }
  .intro-inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(3.5rem, 12vw, 6.5rem) clamp(2.5rem, 8vw, 4rem);
  }

  h1 {
    font-family: var(--font-sans);
    font-size: clamp(2.25rem, 8vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--t-text);
  }

  .lede {
    margin-top: 1.15rem;
    max-width: 54ch;
    line-height: 1.7;
    color: var(--t-text-secondary);
  }
  .lede a {
    color: var(--t-text);
    text-decoration: underline;
    text-decoration-color: var(--t-text-muted);
    text-underline-offset: 3px;
  }
  .lede a:hover {
    color: var(--t-brand);
    text-decoration-color: currentColor;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75ch;
    margin-top: 2rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.75ch;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--t-border-subtle);
    background: color-mix(in srgb, var(--t-surface) 70%, transparent);
    color: var(--t-text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition:
      color 140ms ease,
      border-color 140ms ease;
  }
  .links a:hover {
    color: var(--t-brand);
    border-color: var(--t-brand);
  }

  section {
    margin-top: 3.5rem;
  }

  h2 {
    color: var(--t-text-muted);
    margin-bottom: 0.75rem;
  }

  .mail {
    margin-top: 0.75rem;
  }
  .mail a {
    display: inline-flex;
    align-items: center;
    gap: 1ch;
    color: var(--t-brand);
    text-decoration: underline;
    text-decoration-color: var(--t-text-muted);
    text-underline-offset: 4px;
  }
  .mail a:hover {
    text-decoration-color: currentColor;
  }

  footer {
    margin-top: 4.5rem;
    padding-block: 1.25rem 4rem;
    border-top: 1px solid var(--t-border-subtle);
    font-size: 0.8125rem;
    color: var(--t-text-muted);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2ch;
  }

  /* Chips sitting to the left of an entry's heading. */
  main :global(.logo) {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }
  main :global(.cover) {
    width: 96px;
    height: 60px;
    object-fit: cover;
    border: 1px solid var(--t-border-subtle);
  }

  /* Content inside a fold. */
  main :global(.entry-detail p) {
    line-height: 1.7;
    color: var(--t-text-secondary);
    max-width: 58ch;
  }
  main :global(.entry-detail p + p) {
    margin-top: 0.9rem;
  }
  main :global(.entry-detail .stack) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.5rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    color: var(--t-text-muted);
  }
  main :global(.entry-detail .stack li) {
    border: 1px solid var(--t-border-subtle);
    padding: 0.15rem 0.6rem;
  }
  main :global(.entry-detail .features) {
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }
  main :global(.entry-detail .features li) {
    position: relative;
    padding-left: 3ch;
    line-height: 1.7;
    color: var(--t-text-secondary);
  }
  main :global(.entry-detail .features li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 5px;
    background: var(--t-brand);
  }
  main :global(.shots) {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  main :global(.shots img) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--t-border-subtle);
  }
  main :global(.entry-detail .project-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75ch;
    margin-top: 1.25rem;
  }
  main :global(.entry-detail .project-links a) {
    display: inline-flex;
    align-items: center;
    gap: 0.75ch;
    color: var(--t-brand);
    text-decoration: underline;
    text-decoration-color: var(--t-text-muted);
    text-underline-offset: 3px;
  }
  main :global(.entry-detail .project-links a:hover) {
    text-decoration-color: currentColor;
  }
</style>
