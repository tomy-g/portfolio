---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Entry from '../components/Entry.astro'
import ProjectCard from '../components/ProjectCard.astro'
import DitherField from '../components/DitherField.astro'
import Icon from '../components/Icon.astro'
import { site, experience, education, projects, formatDate } from '../data/site'

const year = new Date().getFullYear()

const social = [
  { label: 'GitHub', url: 'https://github.com/tomy-g', icon: 'github' },
  {
    label: 'LinkedIn',
    url: 'https://www.linkedin.com/in/tomas-goizueta/',
    icon: 'linkedin',
  },
  { label: 'Email', url: `mailto:${site.email}`, icon: 'mail' },
  { label: 'Download CV', url: site.cv, icon: 'cv' },
] as const
---

<Layout>
  <a href="#work" class="skip">Skip to content</a>

  <header class="hero">
    <DitherField />
    <div class="hero-inner">
      <h1>{site.name}</h1>
      <p class="tagline">
        Software engineer at <a
          href="https://ebury.com/"
          target="_blank"
          rel="noopener noreferrer">Ebury</a
        >, in <a
          href={site.locationUrl}
          target="_blank"
          rel="noopener noreferrer">Málaga</a
        >.
      </p>
      <p class="note">
        I came to code through design, and I still build that way — sketching
        the thing before writing the component, and caring about how it behaves
        once it is on a real screen and a real connection.
      </p>

      <nav class="social" aria-label="Elsewhere">
        {
          social.map((s) => (
            <a
              href={s.url}
              title={s.label}
              aria-label={s.label}
              target={s.url.startsWith('mailto') ? undefined : '_blank'}
              rel="noopener noreferrer"
            >
              <Icon name={s.icon} />
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <div class="shell">
    <main>
      <section id="work" aria-labelledby="work-h">
        <h2 id="work-h">Work</h2>
        <div class="ledger">
          {
            experience.map((role) => {
              const hasDetail = role.summary !== '' || role.details.length > 0
              return (
                <Entry
                  heading={role.title}
                  subtitle={role.company}
                  subtitleUrl={role.companyUrl}
                  meta={`${formatDate(role.start)} – ${formatDate(role.end)}`}
                  current={role.end === null}
                  foldable={hasDetail}
                >
                  <Image
                    slot="chip"
                    src={role.logo}
                    alt={`${role.company} logo`}
                    width={88}
                    height={88}
                    loading="eager"
                  />
                  {role.summary && <p>{role.summary}</p>}
                  {role.details.map((d) => (
                    <p>{d}</p>
                  ))}
                  {role.stack.length > 0 && (
                    <ul class="stack">
                      {role.stack.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  )}
                </Entry>
              )
            })
          }
        </div>
      </section>

      <section id="projects" aria-labelledby="projects-h">
        <h2 id="projects-h">Projects</h2>
        <div class="projects">
          {projects.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>

      <section id="education" aria-labelledby="education-h">
        <h2 id="education-h">Education</h2>
        <div class="ledger">
          {
            education.map((e) => (
              <Entry
                heading={e.title}
                subtitle={e.institution}
                subtitleUrl={e.institutionUrl}
                meta={`${e.start} – ${e.end}`}
              >
                <Image
                  slot="chip"
                  src={e.logo}
                  alt={`${e.institution} logo`}
                  width={88}
                  height={88}
                  loading="lazy"
                />
              </Entry>
            ))
          }
        </div>
      </section>

      <section id="contact" aria-labelledby="contact-h">
        <h2 id="contact-h">Contact</h2>
        <p class="lede">The fastest way to reach me is email. I read everything.</p>
        <p class="mail">
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </section>
    </main>

    <footer>
      <p>© {year} {site.name}</p>
      <p>Built with Astro.</p>
    </footer>
  </div>
</Layout>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 1.5rem;
    top: 1rem;
    z-index: 3;
    background: var(--t-surface);
    padding: 0.5rem 0.75rem;
    color: var(--t-brand);
  }

  .shell {
    max-width: 58rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  /* Sits between the waves and the copy so the text always has a floor. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      95deg,
      color-mix(in srgb, var(--t-bg) 62%, transparent) 0%,
      color-mix(in srgb, var(--t-bg) 22%, transparent) 40%,
      transparent 70%
    );
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Barely taller than the copy itself, so there is little slack to
       distribute and the hero reads as a band rather than a screenful. The
       dither no longer takes its scale from this height, so shrinking it
       shows a shorter slice of the field at the same size. */
    min-height: min(52vh, 28rem);
    max-width: 58rem;
    margin-inline: auto;
    padding: clamp(4.5rem, 11vw, 7rem) 1.5rem clamp(2.75rem, 6vw, 3.5rem);
  }

  h1 {
    font-family: var(--font-sans);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.03;
    color: #fff;
  }

  .lede {
    margin-top: 1.15rem;
    max-width: 56ch;
    line-height: 1.75;
    color: var(--t-text-secondary);
  }

  /* The hero steps down in three: name, what I do, then the nuance. */
  .tagline {
    margin-top: 1.4rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.5;
    color: var(--t-text);
  }

  .note {
    margin-top: 1.5rem;
    max-width: 52ch;
    font-size: 0.875rem;
    line-height: 1.85;
    /* Stays on secondary rather than muted: muted measures 3.65:1 against
       the wave colour, which is under AA for text this size. */
    color: var(--t-text-secondary);
  }

  .lede a,
  .tagline a {
    color: var(--t-text);
    text-decoration: underline;
    text-decoration-color: var(--t-text-muted);
    text-underline-offset: 3px;
  }
  .lede a:hover {
    color: var(--t-brand);
    text-decoration-color: currentColor;
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 2.25rem;
  }
  /* No chrome: the marks carry themselves. The box stays as a tap target. */
  .social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-left: -8px;
    color: var(--t-text-secondary);
    transition: color 150ms ease;
  }
  .social a:hover {
    color: var(--t-brand);
  }

  section {
    margin-top: 4rem;
  }
  section:first-child {
    margin-top: 1.5rem;
  }

  h2 {
    font-family: var(--font-sans);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--t-text);
    margin-bottom: 1.25rem;
  }

  .ledger {
    border-bottom: 1px solid var(--t-border-subtle);
  }

  .projects {
    display: grid;
    gap: 1.5rem;
  }

  .mail {
    margin-top: 0.5rem;
  }
  .mail a {
    font-size: 1.0625rem;
    color: var(--t-brand);
    text-decoration: underline;
    text-decoration-color: var(--t-text-muted);
    text-underline-offset: 4px;
  }
  .mail a:hover {
    text-decoration-color: currentColor;
  }

  footer {
    margin-top: 5rem;
    padding-block: 1.25rem 4rem;
    border-top: 1px solid var(--t-border-subtle);
    font-size: 0.8125rem;
    color: var(--t-text-muted);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2ch;
  }

  /* Fold content for work entries. */
  main :global(.entry-detail p) {
    line-height: 1.75;
    color: var(--t-text-secondary);
    max-width: 68ch;
  }
  main :global(.entry-detail p + p) {
    margin-top: 0.9rem;
  }
  main :global(.entry-detail .stack) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }
  main :global(.entry-detail .stack li) {
    border: 1px solid var(--t-border-subtle);
    background: var(--t-bg-deep);
    padding: 0.15rem 0.55rem;
    font-size: 0.75rem;
    color: var(--t-text-muted);
  }
</style>
