---
import Layout from '../layouts/Layout.astro'
import { site, experience, formatDate } from '../data/site'
---

<Layout>
  <main class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="font-sans text-3xl font-semibold tracking-tight">{site.name}</h1>
    <p class="mt-2 text-text-muted">{site.role} — {site.location}</p>
    <p class="mt-8 text-brand">Toolchain smoke test.</p>
    <ul class="mt-4 space-y-1 text-sm text-text-secondary">
      {experience.map((r) => (
        <li>{r.title} @ {r.company} — {formatDate(r.start)} to {formatDate(r.end)}</li>
      ))}
    </ul>
  </main>
</Layout>
