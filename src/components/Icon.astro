---
/**
 * All marks are solid and drawn on the same 24px grid, so the brand glyphs
 * and the generic ones carry the same optical weight in a row together.
 * No icon package, no runtime.
 */
interface Props {
  name: 'github' | 'linkedin' | 'mail' | 'cv' | 'external'
  size?: number
  class?: string
}
const { name, size = 20, class: klass } = Astro.props

/**
 * The brand glyphs are drawn edge to edge on the 24px grid; the generic ones
 * sit inside a margin, so they read a size smaller next to them. Zooming the
 * viewBox about the centre evens them up optically.
 */
const zoom: Partial<Record<Props['name'], number>> = {
  mail: 1.16,
  cv: 1.2,
  external: 1.12,
}
const z = zoom[name] ?? 1
const box = 24 / z
const origin = (24 - box) / 2
const viewBox = `${origin} ${origin} ${box} ${box}`

const icons: Record<Props['name'], string[]> = {
