---

<svg
  class={klass}
  width={size}
  height={size}
  viewBox={viewBox}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {icons[name].map((d) => <path d={d} fill-rule="evenodd" clip-rule="evenodd" />)}
</svg>
