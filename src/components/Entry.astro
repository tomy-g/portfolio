---
/**
 * One row of the ledger: an optional logo, then the position. Rows with body
 * content fold open like a collapsed region in an editor; rows without one
 * render plain, so the marker always means "there is more here".
 */
interface Props {
  heading: string
  subtitle?: string
  subtitleUrl?: string
  meta?: string
  /** Accents the dates: this is the live one. */
  current?: boolean
  foldable?: boolean
}
const {
  heading,
  subtitle,
  subtitleUrl,
  meta,
  current = false,
  foldable = false,
} = Astro.props
const Tag = foldable ? 'details' : 'div'
const Head = foldable ? 'summary' : 'div'
const hasChip = Astro.slots.has('chip')
---

<Tag class="entry">
  <Head class="entry-head">
    <span class="entry-main">
      {
        hasChip && (
          <span class="entry-chip">
            <slot name="chip" />
          </span>
        )
      }
      <span class="entry-text">
        <span class="entry-heading">{heading}</span>
        {
          subtitle && (
            <span class="entry-sub">
              {subtitleUrl ? (
                <a href={subtitleUrl} target="_blank" rel="noopener noreferrer">
                  {subtitle}
                </a>
              ) : (
                subtitle
              )}
            </span>
          )
        }
        {
          meta && (
            <span class:list={['entry-meta', current && 'entry-meta--current']}>
              {meta}
            </span>
          )
        }
      </span>
    </span>

    {foldable && <span class="entry-mark" aria-hidden="true" />}
  </Head>

  {
    foldable && (
      <div class="entry-detail">
        <slot />
      </div>
    )
  }
</Tag>

<style>
  .entry {
    display: block;
    border-top: 1px solid var(--t-border-subtle);
  }

  .entry-head {
    display: grid;
    grid-template-columns: 1fr 2ch;
    align-items: start;
    column-gap: 1ch;
    padding-block: 1.15rem;
    transition: background-color 140ms ease;
  }

  summary.entry-head {
    cursor: pointer;
    list-style: none;
  }
  summary.entry-head::-webkit-details-marker {
    display: none;
  }
  summary.entry-head:hover {
    background-color: color-mix(in srgb, var(--t-surface) 55%, transparent);
  }

  .entry-main {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
  }

  /* A fixed square keeps logos of different proportions on the same axis,
     without drawing a box around them. The nudge lines the mark's top edge
     up with the cap of the position, rather than with its line box. */
  .entry-chip {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-top: 0.15rem;
  }
  .entry-chip :global(img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .entry-text {
    display: block;
    min-width: 0;
  }

  .entry-heading {
    display: block;
    color: var(--t-text);
  }

  .entry-sub {
    display: block;
    color: var(--t-text-secondary);
  }
  .entry-sub a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--t-text-muted);
    text-underline-offset: 3px;
  }
  .entry-sub a:hover {
    color: var(--t-brand);
    text-decoration-color: currentColor;
  }

  .entry-meta {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: var(--t-text-muted);
  }
  /* Carries the "this is the current one" signal the accented year used to. */
  .entry-meta--current {
    color: var(--t-brand);
  }

  .entry-mark {
    color: var(--t-text-muted);
    transition: color 140ms ease;
    justify-self: end;
    line-height: 1.5;
  }
  .entry-mark::before {
    content: '+';
  }
  details[open] > .entry-head .entry-mark::before {
    content: '−';
  }
  summary.entry-head:hover .entry-mark,
  summary.entry-head:focus-visible .entry-mark {
    color: var(--t-brand);
  }

  /* Line the fold's content up with the text, past the logo. */
  .entry-detail {
    padding-left: calc(38px + 1rem);
    padding-bottom: 1.5rem;
  }

  @media (width < 34rem) {
    .entry-detail {
      padding-left: 0;
    }
  }
</style>
