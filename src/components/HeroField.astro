---
/**
 * A dithered pixel lattice, in the spirit of omarchy.org's hero field.
 * Purely decorative: the page reads identically if the script never runs,
 * so it is aria-hidden and carries no content.
 */
---

<canvas id="field" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('field') as HTMLCanvasElement | null
  const ctx = canvas?.getContext('2d', { alpha: true })

  if (canvas && ctx) {
    /** Classic 8x8 ordered dither matrix, 0..63. */
    const BAYER = [
      0, 32, 8, 40, 2, 34, 10, 42, 48, 16, 56, 24, 50, 18, 58, 26, 12, 44, 4,
      36, 14, 46, 6, 38, 60, 28, 52, 20, 62, 30, 54, 22, 3, 35, 11, 43, 1, 33,
      9, 41, 51, 19, 59, 27, 49, 17, 57, 25, 15, 47, 7, 39, 13, 45, 5, 37, 63,
      31, 55, 23, 61, 29, 53, 21,
    ]

    const CELL = 6 // lattice pitch, CSS px
    const DOT = 5 // ink inside each cell, leaving the grid line
    const CURSOR_CELLS = 11 // how far the pointer reaches
    /** The reading column the field must stay out of: 40rem plus padding. */
    const COLUMN = 640 + 48
    /** How far outside the column the field takes full strength, in px. */
    const RAMP_PX = 170
    /** Faint texture allowed everywhere, including behind the text. */
    const FLOOR = 0.07
    /** Resting brightness. The top of the ramp is saved for the cursor, so
     *  the field is calm until you move through it. */
    const AMBIENT = 0.58
    const calm = matchMedia('(prefers-reduced-motion: reduce)')

    const css = getComputedStyle(document.documentElement)
    const token = (n: string, f: string) => css.getPropertyValue(n).trim() || f
    // Index 0 is "leave it dark"; the rest climb toward the crest.
    const RAMP = [
      null,
      token('--t-field-dim', '#39482e'),
      token('--t-field-mid', '#678549'),
      token('--t-field-lit', '#9ece6a'),
      token('--t-field-hover', '#bbdd97'),
      token('--t-field-crest', '#daecc6'),
    ]

    let cols = 0
    let rows = 0
    let pointer = { x: -999, y: -999 }
    const buckets: number[][] = RAMP.map(() => [])

    function resize() {
      const r = canvas!.getBoundingClientRect()
      const dpr = Math.min(devicePixelRatio || 1, 2)
      canvas!.width = Math.round(r.width * dpr)
      canvas!.height = Math.round(r.height * dpr)
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0)
      cols = Math.ceil(r.width / CELL)
      rows = Math.ceil(r.height / CELL)
      falloff()
    }

    /** Cheap drifting field: layered sines read as slow organic blobs. */
    function amplitude(x: number, y: number, t: number) {
      return (
        0.5 +
        0.28 * Math.sin(x * 0.11 + t * 0.34) * Math.cos(y * 0.17 - t * 0.21) +
        0.22 * Math.sin((x + y) * 0.07 - t * 0.15)
      )
    }

    /** Per-column and per-row falloff, recomputed only when the box changes. */
    let margin: number[] = []
    let bottom: number[] = []
    function falloff() {
      const w = canvas!.clientWidth
      const gutter = Math.max(0, (w - COLUMN) / 2)
      margin = Array.from({ length: cols }, (_, x) => {
        const cx = x * CELL
        const out = Math.max(0, gutter - cx, cx - (w - gutter))
        return Math.max(FLOOR, Math.min(1, out / RAMP_PX))
      })
      bottom = Array.from({ length: rows }, (_, y) =>
        Math.min(1, Math.max(0, (1 - y / rows) * 2.8)),
      )
    }

    function draw(t: number) {
      const w = canvas!.clientWidth
      const h = canvas!.clientHeight
      ctx!.clearRect(0, 0, w, h)
      for (const b of buckets) b.length = 0

      const px = pointer.x / CELL
      const py = pointer.y / CELL

      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          let v = amplitude(x, y, t) * AMBIENT

          // The pointer lifts the field near it.
          const dx = x - px
          const dy = y - py
          const d = Math.sqrt(dx * dx + dy * dy)
          if (d < CURSOR_CELLS) v += 0.9 * (1 - d / CURSOR_CELLS) ** 2

          // Keep the ink out of the reading column. The field is strongest
          // in the margins and only a faint texture behind the text, so it
          // never competes with the copy. On narrow screens there are no
          // margins, so only the floor survives.
          v *= margin[x]! * bottom[y]!

          // Ordered dither into the ramp.
          const th = BAYER[(y & 7) * 8 + (x & 7)]! / 64
          const idx = Math.round(v * (RAMP.length - 1) + (th - 0.5) * 1.15)
          if (idx > 0) buckets[Math.min(idx, RAMP.length - 1)]!.push(x, y)
        }
      }

      for (let i = 1; i < RAMP.length; i++) {
        const cells = buckets[i]!
        if (cells.length === 0) continue
        ctx!.fillStyle = RAMP[i]!
        for (let j = 0; j < cells.length; j += 2) {
          ctx!.fillRect(cells[j]! * CELL, cells[j + 1]! * CELL, DOT, DOT)
        }
      }
    }

    let raf = 0
    let running = false
    let last = 0
    let clock = 0
    // ~30fps is plenty for a field this slow, and halves the work.
    const FRAME_MS = 33
    const start = performance.now()
    function frame(now: number) {
      if (!running) return
      if (now - last >= FRAME_MS) {
        last = now
        clock = (now - start) / 1000
        draw(clock)
      }
      raf = requestAnimationFrame(frame)
    }

    function play() {
      if (running || calm.matches) return
      running = true
      raf = requestAnimationFrame(frame)
    }
    function pause() {
      running = false
      cancelAnimationFrame(raf)
    }

    resize()
    draw(0)

    // Setting canvas.width wipes the bitmap, so always repaint after a
    // resize. Waiting for the next frame leaves the field blank whenever
    // rAF is throttled or suspended.
    addEventListener('resize', () => {
      resize()
      draw(clock)
    })

    // Listen on the window so the canvas can stay pointer-events:none and
    // never swallow text selection in the hero.
    addEventListener('pointermove', (e) => {
      const r = canvas.getBoundingClientRect()
      pointer = { x: e.clientX - r.left, y: e.clientY - r.top }
    })

    // Only animate while the field is actually on screen.
    new IntersectionObserver(
      ([entry]) => (entry!.isIntersecting ? play() : pause()),
      { threshold: 0 },
    ).observe(canvas)

    calm.addEventListener('change', () => (calm.matches ? pause() : play()))
  }
</script>

<style>
  #field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.8;
    pointer-events: none;
  }
</style>
