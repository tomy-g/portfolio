---
/**
 * Retro dithered waves.
 *
 * The GLSL is the shader from reactbits.dev/backgrounds/dither (Perlin fbm
 * waves, then an 8x8 Bayer ordered dither), ported to plain WebGL2. The
 * original ships as React + three + @react-three/fiber + postprocessing,
 * which is roughly 600 kB of JavaScript to draw one full-screen quad; this
 * is the same two shaders on a single quad, so the output matches without
 * the runtime.
 *
 * Decorative: aria-hidden, and the hero reads fine if it never starts.
 */
interface Props {
  /** Wave colour, 0..1 RGB. */
  waveColor?: [number, number, number]
  background?: [number, number, number]
  waveSpeed?: number
  waveFrequency?: number
  waveAmplitude?: number
  colorNum?: number
  pixelSize?: number
  mouseRadius?: number
}
const {
  waveColor = [0.2627450980392157, 0.0, 0.7098039215686275], // #4300b5
  background = [0, 0, 0],
  waveSpeed = 0.05,
  waveFrequency = 3,
  waveAmplitude = 0.3,
  colorNum = 4,
  pixelSize = 2,
  mouseRadius = 0.3,
  /** Share of the height, from the bottom, over which the waves dissolve. */
  fadeBottom = 0.42,
  /** Share of the width, from the left, over which they dissolve. */
  fadeLeft = 0.14,
  /** Widest the field spans, in CSS px. Past it the page keeps black margins. */
  fieldWidth = 1360,
  /** Distance, in px, over which each side dissolves once that width is hit. */
  fadeSides = 280,
  /**
   * Height, in px, that one unit of the wave pattern is measured against.
   * Fixed rather than the canvas height so the hero can be resized without
   * rescaling the waves. 40rem is the height the hero used to have, so this
   * reproduces that rendering exactly.
   */
  scaleHeight = 640,
} = Astro.props
const config = JSON.stringify({
  waveColor,
  background,
  waveSpeed,
  waveFrequency,
  waveAmplitude,
  colorNum,
  pixelSize,
  mouseRadius,
  fadeBottom,
  fadeLeft,
  fieldWidth,
  fadeSides,
  scaleHeight,
})
---

<canvas id="dither" aria-hidden="true" data-config={config}></canvas>

<script>
  const canvas = document.getElementById('dither') as HTMLCanvasElement | null
  const gl = canvas?.getContext('webgl2', {
    antialias: false,
    alpha: false,
    powerPreference: 'low-power',
  })

  if (canvas && gl) {
    const cfg = JSON.parse(canvas.dataset.config!)

    const VERT = `#version 300 es
    in vec2 p;
    void main() { gl_Position = vec4(p, 0.0, 1.0); }`

    // Perlin noise, fbm and the wave pattern are from the reactbits shader.
    const FRAG = `#version 300 es
    precision highp float;
    out vec4 fragColor;

    uniform vec2 uRes;
    uniform float uTime;
    uniform float uSpeed;
    uniform float uFreq;
    uniform float uAmp;
    uniform vec3 uWave;
    uniform vec3 uBg;
    uniform vec2 uMouse;
    uniform float uMouseRadius;
    uniform float uMouseOn;
    uniform float uColorNum;
    uniform float uPixelSize;
    uniform float uFadeBottom;
    uniform float uFadeLeft;
    uniform float uFieldWidth;
    uniform float uFadeSides;
    uniform float uScaleHeight;

    vec4 mod289(vec4 x) { return x - floor(x * (1.0/289.0)) * 289.0; }
    vec4 permute(vec4 x) { return mod289(((x * 34.0) + 1.0) * x); }
    vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
    vec2 fade(vec2 t) { return t*t*t*(t*(t*6.0-15.0)+10.0); }

    float cnoise(vec2 P) {
      vec4 Pi = floor(P.xyxy) + vec4(0.0,0.0,1.0,1.0);
      vec4 Pf = fract(P.xyxy) - vec4(0.0,0.0,1.0,1.0);
      Pi = mod289(Pi);
      vec4 ix = Pi.xzxz; vec4 iy = Pi.yyww;
      vec4 fx = Pf.xzxz; vec4 fy = Pf.yyww;
      vec4 i = permute(permute(ix) + iy);
      vec4 gx = fract(i * (1.0/41.0)) * 2.0 - 1.0;
      vec4 gy = abs(gx) - 0.5;
      vec4 tx = floor(gx + 0.5);
      gx = gx - tx;
      vec2 g00 = vec2(gx.x, gy.x); vec2 g10 = vec2(gx.y, gy.y);
      vec2 g01 = vec2(gx.z, gy.z); vec2 g11 = vec2(gx.w, gy.w);
      vec4 norm = taylorInvSqrt(vec4(dot(g00,g00), dot(g01,g01), dot(g10,g10), dot(g11,g11)));
      g00 *= norm.x; g01 *= norm.y; g10 *= norm.z; g11 *= norm.w;
      float n00 = dot(g00, vec2(fx.x, fy.x));
      float n10 = dot(g10, vec2(fx.y, fy.y));
      float n01 = dot(g01, vec2(fx.z, fy.z));
      float n11 = dot(g11, vec2(fx.w, fy.w));
      vec2 fade_xy = fade(Pf.xy);
      vec2 n_x = mix(vec2(n00, n01), vec2(n10, n11), fade_xy.x);
      return 2.3 * mix(n_x.x, n_x.y, fade_xy.y);
    }

    float fbm(vec2 p) {
      float value = 0.0;
      float amp = 1.0;
      float freq = uFreq;
      for (int i = 0; i < 4; i++) {
        value += amp * abs(cnoise(p));
        p *= freq;
        amp *= uAmp;
      }
      return value;
    }

    float pattern(vec2 p) {
      vec2 p2 = p - uTime * uSpeed;
      return fbm(p + fbm(p2));
    }

    const float bayer[64] = float[64](
      0.0/64.0, 48.0/64.0, 12.0/64.0, 60.0/64.0,  3.0/64.0, 51.0/64.0, 15.0/64.0, 63.0/64.0,
      32.0/64.0,16.0/64.0, 44.0/64.0, 28.0/64.0, 35.0/64.0,19.0/64.0, 47.0/64.0, 31.0/64.0,
      8.0/64.0, 56.0/64.0,  4.0/64.0, 52.0/64.0, 11.0/64.0,59.0/64.0,  7.0/64.0, 55.0/64.0,
      40.0/64.0,24.0/64.0, 36.0/64.0, 20.0/64.0, 43.0/64.0,27.0/64.0, 39.0/64.0, 23.0/64.0,
      2.0/64.0, 50.0/64.0, 14.0/64.0, 62.0/64.0,  1.0/64.0,49.0/64.0, 13.0/64.0, 61.0/64.0,
      34.0/64.0,18.0/64.0, 46.0/64.0, 30.0/64.0, 33.0/64.0,17.0/64.0, 45.0/64.0, 29.0/64.0,
      10.0/64.0,58.0/64.0,  6.0/64.0, 54.0/64.0,  9.0/64.0,57.0/64.0,  5.0/64.0, 53.0/64.0,
      42.0/64.0,26.0/64.0, 38.0/64.0, 22.0/64.0, 41.0/64.0,25.0/64.0, 37.0/64.0, 21.0/64.0
    );

    vec3 dither(vec2 fc, vec3 color) {
      vec2 scaled = floor(fc / uPixelSize);
      int x = int(mod(scaled.x, 8.0));
      int y = int(mod(scaled.y, 8.0));
      float threshold = bayer[y * 8 + x] - 0.25;
      float stp = 1.0 / (uColorNum - 1.0);
      color += threshold * stp;
      float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));
      float bias = mix(0.2, 0.0, smoothstep(0.45, 0.8, luminance));
      color = clamp(color - bias, 0.0, 1.0);
      return floor(color * (uColorNum - 1.0) + 0.5) / (uColorNum - 1.0);
    }

    void main() {
      // Sample the wave at the pixelated coordinate: the original renders the
      // wave then reads it back through the same floor(), so this matches.
      vec2 pix = floor(gl_FragCoord.xy / uPixelSize) * uPixelSize;
      // Offset from the centre, in units of uScaleHeight. Algebraically the
      // same as the original divide-by-uRes-then-correct-for-aspect, except
      // the divisor no longer moves: a wave is a fixed number of pixels
      // across whatever size the canvas is, so resizing the hero shows more
      // or less of the field instead of a bigger or smaller version of it.
      vec2 uv = (pix - uRes * 0.5) / uScaleHeight;

      float f = pattern(uv);

      if (uMouseOn > 0.5) {
        vec2 m = vec2(uMouse.x - uRes.x * 0.5, uRes.y * 0.5 - uMouse.y)
          / uScaleHeight;
        float d = length(uv - m);
        f -= 0.5 * (1.0 - smoothstep(0.0, uMouseRadius, d));
      }

      // Fade the wave amount, not the finished colour: the dither still
      // quantises, so the field dissolves into scattered dots and meets the
      // page background with no edge.
      vec2 sp = gl_FragCoord.xy / uRes;
      f *= smoothstep(0.0, uFadeBottom, sp.y);
      f *= smoothstep(0.0, uFadeLeft, sp.x);

      // Past uFieldWidth the field stops widening and dissolves into the page
      // instead of running wall to wall. The canvas still spans the viewport,
      // so uRes -- and with it the wave scale and where it sits -- is
      // unchanged; a narrow screen simply never reaches the edge. The fade
      // distance eases in with the overshoot so nothing snaps on resize, and
      // its 1px floor keeps the smoothstep from degenerating.
      float edge = uFieldWidth * 0.5;
      float soft = max(
        uFadeSides * smoothstep(uFieldWidth, uFieldWidth + uFadeSides, uRes.x),
        1.0
      );
      f *= 1.0 - smoothstep(edge - soft, edge, abs(gl_FragCoord.x - uRes.x * 0.5));

      vec3 col = mix(uBg, uWave, clamp(f, 0.0, 1.0));
      fragColor = vec4(dither(gl_FragCoord.xy, col), 1.0);
    }`

    function compile(type: number, src: string) {
      const s = gl!.createShader(type)!
      gl!.shaderSource(s, src)
      gl!.compileShader(s)
      if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) {
        console.error(gl!.getShaderInfoLog(s))
        return null
      }
      return s
    }

    const vs = compile(gl.VERTEX_SHADER, VERT)
    const fs = compile(gl.FRAGMENT_SHADER, FRAG)

    if (vs && fs) {
      const prog = gl.createProgram()!
      gl.attachShader(prog, vs)
      gl.attachShader(prog, fs)
      gl.linkProgram(prog)
      gl.useProgram(prog)

      const buf = gl.createBuffer()
      gl.bindBuffer(gl.ARRAY_BUFFER, buf)
      gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 3, -1, -1, 3]),
        gl.STATIC_DRAW,
      )
      const loc = gl.getAttribLocation(prog, 'p')
      gl.enableVertexAttribArray(loc)
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0)

      const u = (n: string) => gl.getUniformLocation(prog, n)
      const uRes = u('uRes')
      const uTime = u('uTime')
      const uMouse = u('uMouse')
      const uMouseOn = u('uMouseOn')

      gl.uniform1f(u('uSpeed'), cfg.waveSpeed)
      gl.uniform1f(u('uFreq'), cfg.waveFrequency)
      gl.uniform1f(u('uAmp'), cfg.waveAmplitude)
      gl.uniform3fv(u('uWave'), cfg.waveColor)
      gl.uniform3fv(u('uBg'), cfg.background)
      gl.uniform1f(u('uMouseRadius'), cfg.mouseRadius)
      gl.uniform1f(u('uColorNum'), cfg.colorNum)
      gl.uniform1f(u('uPixelSize'), cfg.pixelSize)
      gl.uniform1f(u('uFadeBottom'), cfg.fadeBottom)
      gl.uniform1f(u('uFadeLeft'), cfg.fadeLeft)
      gl.uniform1f(u('uFieldWidth'), cfg.fieldWidth)
      gl.uniform1f(u('uFadeSides'), cfg.fadeSides)
      gl.uniform1f(u('uScaleHeight'), cfg.scaleHeight)
      gl.uniform1f(uMouseOn, 0)

      // The output is pixelated, so there is nothing to gain from a retina
      // buffer and four times the fragments to pay for.
      function resize() {
        const r = canvas!.getBoundingClientRect()
        const w = Math.max(1, Math.round(r.width))
        const h = Math.max(1, Math.round(r.height))
        if (canvas!.width !== w || canvas!.height !== h) {
          canvas!.width = w
          canvas!.height = h
        }
        gl!.viewport(0, 0, w, h)
        gl!.uniform2f(uRes, w, h)
      }

      let clock = 0
      function render(t: number) {
        resize()
        gl!.uniform1f(uTime, t)
        gl!.drawArrays(gl!.TRIANGLES, 0, 3)
      }

      const calm = matchMedia('(prefers-reduced-motion: reduce)')
      let raf = 0
      let running = false
      const start = performance.now()

      function frame(now: number) {
        if (!running) return
        clock = (now - start) / 1000
        render(clock)
        raf = requestAnimationFrame(frame)
      }
      function play() {
        if (running || calm.matches) return
        running = true
        raf = requestAnimationFrame(frame)
      }
      function pause() {
        running = false
        cancelAnimationFrame(raf)
      }

      render(0)
      addEventListener('resize', () => render(clock))

      addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect()
        if (e.clientY > r.bottom || e.clientY < r.top) {
          gl.uniform1f(uMouseOn, 0)
          return
        }
        gl.uniform1f(uMouseOn, 1)
        gl.uniform2f(uMouse, e.clientX - r.left, e.clientY - r.top)
      })

      new IntersectionObserver(
        ([entry]) => (entry!.isIntersecting ? play() : pause()),
        { threshold: 0 },
      ).observe(canvas)

      calm.addEventListener('change', () => (calm.matches ? pause() : play()))
    }
  }
</script>

<style>
  #dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
  }
</style>
