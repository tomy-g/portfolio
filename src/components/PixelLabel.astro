---
import { layout, GLYPH_HEIGHT } from '../lib/pixelfont'

interface Props {
  text: string
  /** Size of one pixel, in CSS px. */
  cell?: number
  class?: string
}
const { text, cell = 3, class: klass } = Astro.props
const { cells, width } = layout(text)
---

<svg
  class={klass}
  role="img"
  aria-label={text}
  width={width * cell}
  height={GLYPH_HEIGHT * cell}
  viewBox={`0 0 ${width} ${GLYPH_HEIGHT}`}
  shape-rendering="crispEdges"
  fill="currentColor"
>
  {cells.map((c) => <rect x={c.x} y={c.y} width="1" height="1" />)}
</svg>
